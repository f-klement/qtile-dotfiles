# GENERATED by ~/bin/theme.sh from settings.ini.in - edit the .in file, not this one.
[Settings]
# Rose Pine GTK theme (~/.themes). FALLBACK only: gsettings/XSETTINGS is authoritative.
gtk-theme-name=@GTK_THEME@
gtk-icon-theme-name=@ICON_THEME@
gtk-cursor-theme-name=@CURSOR_THEME@
gtk-cursor-theme-size=24
gtk-font-name=Cantarell 11
gtk-application-prefer-dark-theme=@PREFER_DARK@
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=none

# Output layout for the qtile Wayland session (started by autostart_wayland.sh).
# Mirrors the Plasma/KScreen layout of the Latitude 5550 + dock. kanshi picks the
# first profile whose outputs are all connected, and re-evaluates on hotplug.
# Port names (DP-3/DP-5) come from the dock's MST hub; if they shift after a
# re-dock, match by description instead (see `wlr-randr` for the strings).
# config.py derives screen roles from these rects: portrait -> group 1 (brave),
# landscape -> group 2 (codium), smallest (laptop panel) -> groups 5/6.
# DP-5 is KScreen "Left" = wl_output transform 90; use 270 if it comes up upside down.
# Refresh left out on purpose: an inexact @Hz makes kanshi reject the whole profile.

profile docked {
  output eDP-1 enable mode 1920x1080 position 0,840 scale 1
  output DP-5  enable mode 1920x1200 position 1920,0 transform 90 scale 1
  output DP-3  enable mode 1920x1200 position 3120,382 scale 1
}

profile undocked {
  output eDP-1 enable mode 1920x1080 position 0,0 scale 1
}

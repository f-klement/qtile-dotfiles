/* Rosé Pine Dawn (light) palette for config.rasi. Copied to colors.rasi by ~/bin/theme.sh. */
* {
  base:      #faf4ed;
  surface:   #fffaf3;
  overlay:   #f2e9e1;
  muted:     #9893a5;
  subtle:    #797593;
  text:      #575279;
  love:      #b4637a;
  gold:      #ea9d34;
  rose:      #d7827e;
  pine:      #286983;
  foam:      #56949f;
  iris:      #907aa9;
  hl-med:    #dfdad9;
}
element-text {
  highlight: bold #ea9d34;
}
configuration {
  icon-theme: "Papirus-Light";
}

/* rofi 1.7 - Rosé Pine launcher. `@theme "/dev/null"` drops rofi's built-in
 * default theme so nothing (cream rows, grey selection) bleeds through.
 * Palette + icon theme come from colors.rasi, generated by ~/bin/theme.sh from
 * colors-rose-pine.rasi (dark) or colors-rose-pine-dawn.rasi (light). */
@theme "/dev/null"
@import "colors.rasi"

configuration {
  modi: "drun,run";
  show-icons: true;
  display-drun: "Apps";
  display-run: "Run";
  font: "Cantarell 12";
  terminal: "kitty";
  drun-display-format: "{name}";
  disable-history: false;
  hide-scrollbar: true;
}

* {
  background-color: transparent;
  text-color:       @text;
  spacing:          0;
  margin:           0;
  padding:          0;
}

window {
  location:         center;
  anchor:           center;
  width:            640px;
  background-color: @base;
  border:           2px;
  border-color:     @iris;
  border-radius:    12px;
  padding:          16px;
}

mainbox {
  spacing:  12px;
  children: [ inputbar, listview ];
}

inputbar {
  children:         [ prompt, entry ];
  background-color: @overlay;
  border-radius:    8px;
  padding:          10px 14px;
  spacing:          10px;
}

prompt {
  text-color:   @iris;
  font:         "Cantarell Bold 12";
}

entry {
  placeholder:       "Search…";
  placeholder-color: @muted;
  cursor:            text;
}

listview {
  lines:       8;
  columns:     1;
  fixed-height: false;
  dynamic:     true;
  scrollbar:   false;
  spacing:     2px;
}

element {
  padding:       8px 12px;
  spacing:       10px;
  border-radius: 8px;
  cursor:        pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @text; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @love; }
element normal.active, element alternate.active { background-color: transparent; text-color: @foam; }
element selected.normal { background-color: @hl-med; text-color: @iris; }
element selected.urgent { background-color: @hl-med; text-color: @love; }
element selected.active { background-color: @hl-med; text-color: @foam; }

element-icon {
  size:             1.4em;
  background-color: transparent;
  text-color:       inherit;
}
element-text {
  background-color: transparent;
  text-color:       inherit;
  vertical-align:   0.5;
  /* highlight (gold match colour) lives in colors.rasi: it takes no @reference */
}

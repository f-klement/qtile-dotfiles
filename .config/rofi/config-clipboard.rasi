/* Clipboard history picker (ClipManager.sh, SUPER+ALT+V) -- taller
 * single-column dmenu list, piped from `cliphist list`. Same look as
 * config.rasi minus the mode-switcher (dmenu has no modi to switch). */
@theme "/dev/null"
@import "colors.rasi"

configuration {
  font: "Cantarell 12";
  hide-scrollbar: true;
}

* {
  background-color: transparent;
  text-color:       @text;
  spacing:          0;
  margin:           0;
  padding:          0;
}

window {
  location:         center;
  anchor:           center;
  width:            480px;
  background-color: @base;
  border:           2px;
  border-color:     @iris;
  border-radius:    12px;
  padding:          16px;
}

mainbox {
  spacing:  12px;
  children: [ inputbar, listview ];
}

inputbar {
  children:         [ prompt, entry ];
  background-color: @overlay;
  border-radius:    8px;
  padding:          10px 14px;
  spacing:          10px;
}

prompt {
  text-color: @iris;
  font:       "Cantarell Bold 12";
}

entry {
  placeholder:       "Search clipboard…";
  placeholder-color: @muted;
  cursor:            text;
}

listview {
  lines:        20;
  columns:      1;
  fixed-height: false;
  dynamic:      true;
  scrollbar:    false;
  spacing:      2px;
}

element {
  padding:       8px 12px;
  border-radius: 8px;
  cursor:        pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @text; }
element selected.normal { background-color: @hl-med; text-color: @iris; }

element-text {
  background-color: transparent;
  text-color:        inherit;
  vertical-align:    0.5;
}

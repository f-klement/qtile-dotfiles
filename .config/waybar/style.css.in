/* GENERATED by ~/bin/theme.sh from style.css.in - edit the .in file, not this one.
 * Rose Pine / Rose Pine Dawn, same slot mapping as qtile's colors.py
 * (RosePine/RosePineDawn) so light/dark always match qtile's own bar.
 * waybar's config.json has "reload_style_on_change": true, so theme.sh
 * writing this file live-reloads the bar the same way it nudges kitty/rofi/
 * dunst -- no separate waybar restart needed on toggle. */
* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 12px;
    min-height: 0;
}

window#waybar {
    background-color: @BASE_A@; /* base, 0.70 alpha like qtile's bar opacity */
    color: @TEXT@;
}

#workspaces button {
    padding: 0 6px;
    color: @MUTED@;
    background: transparent;
    border: none;
}
#workspaces button.active {
    color: @IRIS@;
}
#workspaces button.focused {
    border-bottom: 2px solid @IRIS@;
}

#custom-separator {
    color: @MUTED@;
    padding: 0 4px;
}

#clock {
    color: @TEXT@;
}

#idle_inhibitor, #custom-menu, #custom-lock, #custom-light-dark,
#custom-weather, #custom-swaync, #tray, #mpris, #bluetooth, #battery,
#pulseaudio, #custom-power, #wlr-taskbar {
    padding: 0 6px;
}

#idle_inhibitor     { color: @FOAM@; }
#custom-menu        { color: @IRIS@; }
#custom-lock        { color: @LOVE@; }
#custom-light-dark  { color: @GOLD@; }
#custom-weather     { color: @PINE@; }
#custom-swaync      { color: @ROSE@; }
#wlr-taskbar         { color: @TEXT@; }
#mpris              { color: @IRIS@; }
#bluetooth          { color: @PINE@; }
#battery            { color: @TEXT@; }
#battery.warning    { color: @GOLD@; }
#battery.critical   { color: @LOVE@; }
#pulseaudio         { color: @IRIS@; }
#pulseaudio.muted   { color: @LOVE@; }
#custom-power       { color: @TEXT@; }

#tray {
    color: @TEXT@;
}
#tray > .passive {
    -gtk-icon-effect: dim;
}
#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    color: @LOVE@;
}

/* waybar recolours "-symbolic" tray icons (radiotray-ng's
 * radiotray-custom-{on,off}-symbolic, see ~/.local/share/icons) with the
 * item's own style context, and does the first load before the item is
 * packed into #tray -- at that point #tray's color isn't inherited yet
 * and the pixbuf bakes in the GTK theme's default fg. A screen-level rule
 * does reach the unparented widget: name the item directly (a bare
 * GtkEventBox, css node "widget", carrying waybar's SNI status class). */
widget.active, widget.passive, widget.needs-attention { color: @TEXT@; }
